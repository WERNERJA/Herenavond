# Firebase Realtime Database
# Maak project aan op https://console.firebase.google.com
# Database URL vind je in Realtime Database > Data
FIREBASE_DB_URL=https://jouw-project-default-rtdb.europe-west1.firebasedatabase.app

# Firebase Database Secret
# Project Settings > Service Accounts > Database Secrets > Show
FIREBASE_SECRET=jouw_database_secret_hier

# CalMeBot WhatsApp
# Stuur "I allow callmebot to send me messages" naar +34 644 25 90 15
# Je ontvangt een apikey terug
CALMEBOT_PHONE=32475XXXXXX
CALMEBOT_APIKEY=jouw_calmebot_apikey
